# Full reference of every variable. For a local setup copy the package-level templates instead:
#   apps/api/.env.example -> apps/api/.env  and  apps/web/.env.example -> apps/web/.env.local

DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5438/opm_community?schema=public"
ANTHROPIC_API_KEY="your-anthropic-api-key"
OPENAI_API_KEY="your-openai-api-key"
PORT=4000

# --- Authentication (see docs/authentication.md) ---
# Shared by apps/web (signs access tokens, encrypts the session cookie) and apps/api (verifies them).
# At least 32 characters, e.g. `openssl rand -base64 48`. The example value is for local development only; change it before production.
AUTH_SECRET="local-dev-only-auth-secret-change-before-production-0123456789"
# apps/web only: the public origin of the web app (required in production).
NEXTAUTH_URL="http://localhost:3000"
# Development quick login is ON outside production. In production it stays OFF unless these are "true".
# apps/api reads AUTH_DEV_LOGIN, apps/web reads NEXT_PUBLIC_AUTH_DEV_LOGIN (set both or neither).
# AUTH_DEV_LOGIN=true
# NEXT_PUBLIC_AUTH_DEV_LOGIN=true
# apps/api only: set to "true" to activate new registrations immediately (demos). Default: they start as PENDING_VERIFICATION.
# AUTH_AUTO_VERIFY=true
# Optional, used by `prisma db seed`: gives every seeded alumnus this password so email/password
# sign-in works. Without it, seeded accounts have no password (quick login only).
# SEED_PASSWORD="choose-a-demo-password"
