# Copy to apps/api/.env (cp apps/api/.env.example apps/api/.env).
# Read by the API and by the Prisma CLI (migrate, seed).
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5438/opm_community?schema=public"
PORT=4000

# Required for matchmaking. Replace with your own keys.
ANTHROPIC_API_KEY="your-anthropic-api-key"
OPENAI_API_KEY="your-openai-api-key"
# Optional: override the default Claude model.
# ANTHROPIC_MODEL=

# Local development default (>= 32 chars). It MUST be identical to AUTH_SECRET in apps/web/.env.local.
# Generate your own with: openssl rand -base64 48
AUTH_SECRET="local-dev-only-auth-secret-change-before-production-0123456789"

# Optional: password for every seeded alumnus (enables email/password sign-in).
# SEED_PASSWORD="choose-a-demo-password"
# Optional: activate new registrations immediately (demos).
# AUTH_AUTO_VERIFY=true
# Optional: CORS allow-list origin (default http://localhost:3000).
# WEB_ORIGIN="http://localhost:3000"
