# Copy to apps/web/.env.local (cp apps/web/.env.example apps/web/.env.local).

# Local development default (>= 32 chars). It MUST be identical to AUTH_SECRET in apps/api/.env.
# Generate your own with: openssl rand -base64 48
AUTH_SECRET="local-dev-only-auth-secret-change-before-production-0123456789"
# Public origin of the web app (NextAuth).
NEXTAUTH_URL="http://localhost:3000"
# API origin used by the browser (default http://localhost:4000).
NEXT_PUBLIC_API_URL="http://localhost:4000"
